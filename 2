from src.analysis.failure_analyzer import FailureAnalyzer
from src.core.trajectory import Trajectory
from src.llm.client import LLMClient
from src.counterfactual.validator import CounterfactualValidator

def main():
    trajectory = Trajectory.load_json("outputs/react_baseline/episode_000.json")
    llm = LLMClient()
    analyzer = FailureAnalyzer(llm)

    analysis = analyzer.analyze(trajectory)

    print("\n===== Failure Analysis =====")
    print(f"Critical step: {analysis.critical_step}")
    print(f"Failure type: {analysis.failure_type}")
    print(f"Failure reason: {analysis.failure_reason}")
    print(f"Counterfactual action: {analysis.counterfactual_action}")
    print(f"Expected effect: {analysis.expected_effect}")

    critical_step = trajectory.steps[analysis.critical_step]

    print("\n===== Counterfactual Check =====")
    print(f"Original action: {critical_step.action}")
    print(f"Counterfactual action: {analysis.counterfactual_action}")
    print(
        "Is admissible:",
        analysis.counterfactual_action in critical_step.admissible_actions,
    )
    
    validator = CounterfactualValidator(llm)
    result = validator.validate(trajectory=trajectory, analysis=analysis)

    print("\n===== Counterfactual Validation =====")
    print(f"Critical step: {result.critical_step}")
    print(f"Original action: {result.original_action}")
    print(f"Counterfactual action: {result.counterfactual_action}")
    print(f"Original success: {result.original_success}")
    print(f"Counterfactual success: {result.counterfactual_success}")
    print(f"Original steps: {result.original_steps}")
    print(f"Counterfactual steps: {result.counterfactual_steps}")

if __name__ == "__main__":
    main()
